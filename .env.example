# Copiá este archivo como .env (en la raíz del repo) y completá tus claves. .env no se sube al repo.
OPENWEATHER_API_KEY=tu_clave_de_openweather
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5/weather
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
ORIGEN_LAT=-34.5928
ORIGEN_LON=-58.3886
IA_ENDPOINT=/.netlify/functions/chat
# Solo servidor (no va a env.js): clave de Groq
GROQ_API_KEY=tu_clave_de_groq
# EcoBici en vivo: credenciales de https://api-transporte.buenosaires.gob.ar/ (solo servidor, no van a env.js)
ECOBICI_CLIENT_ID=tu_client_id
ECOBICI_CLIENT_SECRET=tu_client_secret
ECOBICI_ENDPOINT=/.netlify/functions/ecobici
